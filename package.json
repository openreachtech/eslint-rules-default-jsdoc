{
  "name": "@openreachtech/eslint-rules-default-jsdoc",
  "version": "1.0.3",
  "description": "A showcasing package all the JSDoc plugin rules of ESLint.",
  "main": "index.js",
  "files": [
    "index.js",
    "rules/",
    "types/"
  ],
  "types": "types/index.d.ts",
  "scripts": {
    "l": "npm run lint",
    "lint": "eslint .",
    "test": "export NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\"; jest --maxWorkers=5"
  },
  "type": "module",
  "keywords": [
    "ESLint"
  ],
  "author": "Open Reach Tech Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreachtech/eslint-rules-default-jsdoc.git"
  },
  "dependencies": {
    "eslint-plugin-jsdoc": "^64.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-openreachtech": "^1.0.1",
    "jest": "^30.4.2"
  },
  "overrides": {
    "flatted": "^3.4.4"
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
